<odoo>


<record id="view_editorial_tree" model="ir.ui.view">

    <field name="name">
        editorial.tree
    </field>


    <field name="model">biblioteca.editorial</field>


    <field name="arch" type="xml">

        <tree>

            <field name="name"/>

            <field name="pais"/>

        </tree>

    </field>

</record>
<record id="view_editorial_form" model="ir.ui.view">

    <field name="name">
        editorial.form
    </field>


    <field name="model">biblioteca.editorial</field>


    <field name="arch" type="xml">

        <form>

            <sheet>


                <group>

                    <field name="name"/>

                    <field name="pais"/>

                </group>


                <notebook>


                    <page string="Libros publicados">


                        <field name="libros_ids">


                            <tree editable="bottom">

                                <field name="name"/>

                                <field name="autor"/>

                                <field name="fecha_publicacion"/>

                            </tree>


                        </field>


                    </page>


                </notebook>


            </sheet>

        </form>

    </field>

</record>

<record id="biblioteca_editorial_action" model="ir.actions.act_window">
    <field name="name">Editoriales</field>
    <field name="res_model">biblioteca.editorial</field>
    <field name="view_mode">tree,form</field>
</record>


</odoo>