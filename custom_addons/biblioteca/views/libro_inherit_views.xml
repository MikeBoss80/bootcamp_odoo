<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="biblioteca_libro_view_form_inherit" model="ir.ui.view">

        <field name="name">biblioteca.libro.form.inherit</field>

        <field name="model">biblioteca.libro</field>

        <field name="inherit_id" ref="biblioteca.biblioteca_libro_view_form"/>

        <field name="arch" type="xml">

            <xpath expr="//sheet" position="inside">    

                <group string="Información del sistema">
                    <field name="id" readonly="1"/>
                    <field name="create_uid" readonly="1"/>
                    <field name="create_date" readonly="1"/>

                </group>

            </xpath>

        </field>

    </record>

</odoo>