<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="biblioteca_libro_view_tree" model="ir.ui.view">
        <field name="name">biblioteca.libro.tree</field>
        <field name="model">biblioteca.libro</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="genero"/>
                <field name="isbn"/>
                <field name="disponible"/>
                <field name="autor"/>
                <field name="etiqueta_ids" widget="many2many_tags"/>
                <field name="editorial_id"/>
                <field name="fecha_publicacion"/>
                <field name="fecha_ingreso"/>
            </tree>
        </field>
    </record>

    <record id="biblioteca_libro_view_form" model="ir.ui.view">
        <field name="name">biblioteca.libro.form</field>
        <field name="model">biblioteca.libro</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="isbn"/>
                        <field name="genero"/>
                        <field name="disponible"/>
                        <field name="autor"/>
                        <field name="etiqueta_ids" widget="many2many_tags"/>
                        <field name="fecha_publicacion"/>
                        <field name="editorial_id"/>
                        <field name="fecha_ingreso"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

     <record id="biblioteca_libro_action" model="ir.actions.act_window">
        <field name="name">Libros</field>
        <field name="res_model">biblioteca.libro</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>